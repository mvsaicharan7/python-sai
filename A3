# 2. Benchmark for 1,000 and 100,000 Contacts
def generate_contacts(n: int, unique_ratio: float = 0.7) -> list[dict]:
    random.seed(42)
    unique_count = int(n * unique_ratio)
    base_numbers = [f"9840{i:06d}" for i in range(unique_count)]
    formats = [
        lambda num: f"+91 {num[:5]} {num[5:]}",
        lambda num: num,
        lambda num: f"0{num[:5]}-{num[5:]}",
    ]
    return [
        {
            "name": f"Dr. User {num[-4:]}" if i % 3 == 0 else f"user {num[-4:]} full",
            "phone": random.choice(formats)(num),
            "email": f"u{i % unique_count}@mail.com" if i % 4 != 0 else "",
        }
        for i in range(n)
        for num in [random.choice(base_numbers)]
    ]

print("\n=== BENCHMARK RESULTS ===")
for n in [1000, 100000]:
    data = generate_contacts(n)
    t0 = time.perf_counter()
    res_dict = merge_contacts_dict(data)
    t_dict = (time.perf_counter() - t0) * 1000

    if n == 1000:
        t0 = time.perf_counter()
        res_pair = merge_contacts_pairwise(data)
        t_pair = (time.perf_counter() - t0) * 1000
        print(f"N = {n:>7,} | Unique: {len(res_dict):>6,} | Dict Time: {t_dict:>8.2f} ms | Pairwise Time: {t_pair:>8.2f} ms | Match: {len(res_dict) == len(res_pair)}")
    else:
        print(f"N = {n:>7,} | Unique: {len(res_dict):>6,} | Dict Time: {t_dict:>8.2f} ms | Pairwise: O(n^2) (~10,000x N=1,000)")
