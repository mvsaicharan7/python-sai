import re
import time
import random

HONORIFICS = {"dr", "mr", "mrs", "ms", "prof", "er", "shri", "smt"}

def normalise_phone(raw_phone: str) -> str:
    """Strips non-digits and keeps the last 10 digits for standard matching."""
    if not raw_phone:
        return ""
    digits = re.sub(r"\D", "", raw_phone)
    return digits[-10:] if len(digits) > 10 else digits

def normalise_name(raw_name: str) -> str:
    """Removes punctuation/honorifics and formats in Title Case."""
    if not raw_name:
        return ""
    cleaned = re.sub(r"[^\w\s]", " ", raw_name).strip()
    tokens = [t for t in cleaned.split() if t.lower() not in HONORIFICS]
    return " ".join(tokens).title() if tokens else cleaned.title()

def choose_best_name(existing_name: str, candidate_name: str) -> str:
    """Retains the more descriptive (longer) normalised name."""
    if not existing_name:
        return candidate_name
    if not candidate_name:
        return existing_name
    return candidate_name if len(candidate_name) > len(existing_name) else existing_name

def merge_contacts_dict(contacts: list[dict]) -> list[dict]:
    """Merges contacts in O(n) average time using a phone-keyed dictionary."""
    merged_by_phone = {}
    no_phone_contacts = []

    for contact in contacts:
        norm_phone = normalise_phone(contact.get("phone", ""))
        norm_name = normalise_name(contact.get("name", ""))
        raw_email = (contact.get("email") or "").strip().lower()

        if not norm_phone:
            no_phone_contacts.append({
                "name": norm_name or "Unknown",
                "phones": set(),
                "emails": {raw_email} if raw_email else set(),
            })
            continue

        if norm_phone not in merged_by_phone:
            merged_by_phone[norm_phone] = {
                "name": norm_name or "Unknown",
                "phones": {norm_phone},
                "emails": {raw_email} if raw_email else set(),
            }
        else:
            record = merged_by_phone[norm_phone]
            record["name"] = choose_best_name(record["name"], norm_name)
            record["phones"].add(norm_phone)
            if raw_email:
                record["emails"].add(raw_email)

    return list(merged_by_phone.values()) + no_phone_contacts

def merge_contacts_pairwise(contacts: list[dict]) -> list[dict]:
    """Alternative O(n^2) pairwise scan for complexity comparison."""
    merged = []
    for contact in contacts:
        norm_phone = normalise_phone(contact.get("phone", ""))
        norm_name = normalise_name(contact.get("name", ""))
        raw_email = (contact.get("email") or "").strip().lower()

        found = False
        if norm_phone:
            for record in merged:
                if norm_phone in record["phones"]:
                    record["name"] = choose_best_name(record["name"], norm_name)
                    if raw_email:
                        record["emails"].add(raw_email)
                    found = True
                    break

        if not found:
            merged.append({
                "name": norm_name or "Unknown",
                "phones": {norm_phone} if norm_phone else set(),
                "emails": {raw_email} if raw_email else set(),
            })
    return merged

